package main

import (
	"strings"
	"testing"
)

func TestNextVersion(t *testing.T) {
	const bad = "not patch, minor, major"

	tests := []struct {
		name, current, request, want, wantErr string
	}{
		{"patch", "1.2.3", "patch", "1.2.4", ""},
		{"minor resets patch", "1.2.3", "minor", "1.3.0", ""},
		{"major resets the rest", "1.2.3", "major", "2.0.0", ""},
		{"exact version", "1.2.3", "2.5.0", "2.5.0", ""},
		{"release after a prerelease", "2.0.0-rc.1", "2.0.0", "2.0.0", ""},
		{"same version", "1.2.3", "1.2.3", "", "already the version"},
		{"keyword on a prerelease", "2.0.0-rc.1", "patch", "", "is a prerelease"},
		{"leading v", "1.2.3", "v1.2.4", "", "Write 1.2.4 without the v"},
		{"build metadata", "1.2.3", "1.2.4+build", "", bad},
		{"leading zero", "1.2.3", "1.02.4", "", bad},
		{"newline", "1.2.3", "1.2.4\n", "", bad},
		{"invalid current", "dev", "patch", "", "not a semantic version"},
		{"number too large", "1.2.99999999999", "patch", "", "too large"},
	}

	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			got, err := nextVersion(test.current, test.request)
			if !errorMatches(err, test.wantErr) || got != test.want {
				t.Fatalf("got %q, %v; want %q, an error with %q", got, err, test.want, test.wantErr)
			}
		})
	}
}

func TestSetVersion(t *testing.T) {
	tests := []struct {
		name, doc, want, wantErr string
	}{
		{
			"keeps every other byte",
			"{\n  \"id\": \"x\",\n  \"version\": \"1.0.0\",\n  \"engines\": {\n    \"version\": \"9\"\n  }\n}\n",
			"{\n  \"id\": \"x\",\n  \"version\": \"1.1.0\",\n  \"engines\": {\n    \"version\": \"9\"\n  }\n}\n",
			"",
		},
		{"tabs and odd spacing", "{\t\"version\" :\n\t\"1.0.0\" }", "{\t\"version\" :\n\t\"1.1.0\" }", ""},
		{"compact", `{"a":["version"],"version":"1.0.0"}`, `{"a":["version"],"version":"1.1.0"}`, ""},
		{"escaped value", `{"version":"1\u002e0.0"}`, `{"version":"1.1.0"}`, ""},
		{"only a nested version", `{"engines":{"version":"1.0.0"}}`, "", `no "version" key`},
		{"two version keys", `{"version":"1.0.0","version":"1.0.1"}`, "", "two"},
		{"not a string", `{"version":1}`, "", "not a string"},
		{"not an object", `["version"]`, "", "not a JSON object"},
		{"truncated", `{"a":`, "", "EOF"},
	}

	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			got, err := setVersion([]byte(test.doc), "1.1.0")
			if !errorMatches(err, test.wantErr) || string(got) != test.want {
				t.Fatalf("got %q, %v; want %q, an error with %q", got, err, test.want, test.wantErr)
			}
		})
	}

	for _, bad := range []string{"dev", `1.0.0","x":"`} {
		if _, err := setVersion([]byte(`{"version":"1.0.0"}`), bad); err == nil {
			t.Errorf("%q was written", bad)
		}
	}
}

// errorMatches reports whether err is nil when want is empty, and otherwise
// holds want.
func errorMatches(err error, want string) bool {
	if want == "" {
		return err == nil
	}

	return err != nil && strings.Contains(err.Error(), want)
}
