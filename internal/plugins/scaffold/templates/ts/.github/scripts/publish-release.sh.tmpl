#!/usr/bin/env bash
# Usage: publish-release.sh DIR
# Writes checksums.txt for the archives in DIR, one per platform of plugin.json,
# then creates the GitHub release (and with it the tag at GITHUB_SHA) or completes
# one left unfinished. checksums.txt goes up last: read-version.sh takes it as
# the sign of a complete release. Needs gh with GH_TOKEN and GH_REPO.
set -euo pipefail
# shellcheck source=lib.sh
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

dir=${1:?usage: publish-release.sh DIR}
version=$(project_version)
tag="v$version"
name=__PLUGIN_NAME__

archives=()
while IFS= read -r platform; do
  extension=tar.gz
  [[ $platform == windows-* ]] && extension=zip
  archive="${name}_${version}_${platform}.${extension}"
  [[ -f $dir/$archive ]] || {
    echo "The archive $dir/$archive is missing." >&2
    exit 1
  }
  archives+=("$archive")
done < <(jq -r '.platforms[]' plugin.json)

cd "$dir"
if command -v sha256sum >/dev/null; then
  sha256sum -- "${archives[@]}" >checksums.txt
else
  shasum -a 256 -- "${archives[@]}" >checksums.txt
fi

if gh release view "$tag" >/dev/null 2>&1; then
  gh release upload "$tag" --clobber -- "${archives[@]}"
else
  gh release create "$tag" --target "${GITHUB_SHA:?GITHUB_SHA is not set}" --title "$tag" --generate-notes -- "${archives[@]}"
fi
gh release upload "$tag" --clobber -- checksums.txt
echo "Published $tag."
