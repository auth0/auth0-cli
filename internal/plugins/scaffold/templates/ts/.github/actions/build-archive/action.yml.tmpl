name: Build archive
description: Compile the plugin for one platform and upload its archive as a workflow artifact.

inputs:
  platform:
    description: The platform in plugin.json, such as linux-x64-musl.
    required: true

runs:
  using: composite
  steps:
    - shell: bash
      env:
        PLATFORM: ${{ inputs.platform }}
      run: bash .github/scripts/build-archive.sh "$PLATFORM"
    - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
      with:
        name: archive-${{ inputs.platform }}
        path: out/*
        if-no-files-found: error
