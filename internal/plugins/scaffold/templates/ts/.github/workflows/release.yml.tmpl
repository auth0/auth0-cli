name: Release

# Runs when a change to the version in plugin.json reaches main, which is what
# merging the pull request from `bun run release` does. Run it by hand to finish
# a release that failed half way.
on:
  push:
    branches: [main]
    paths: [plugin.json]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  version:
    # A manual run on another branch is skipped, and so is every job that needs it.
    if: github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    outputs:
      tag: ${{ steps.read.outputs.tag }}
      release-exists: ${{ steps.read.outputs.release-exists }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0 # The tags are needed to see what exists.
          persist-credentials: false
      - id: read
        uses: ./.github/actions/read-version

  # When the release exists, this job is skipped and so is every job that needs it.
  ci:
    needs: version
    if: needs.version.outputs.release-exists != 'true'
    uses: ./.github/workflows/ci.yml

  build:
    needs: [version, ci]
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        # The platforms of plugin.json. Each builds for the Bun target bun-<platform>.
        platform: [darwin-arm64, darwin-x64, linux-arm64, linux-x64, linux-arm64-musl, linux-x64-musl, windows-x64]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: 1.4.4
      - run: bun install --frozen-lockfile
      - uses: ./.github/actions/build-archive
        with:
          platform: ${{ matrix.platform }}

  publish:
    needs: [version, build]
    runs-on: ubuntu-latest
    permissions:
      contents: write # Creates the tag and the release, and uploads the assets.
    concurrency:
      group: release-${{ needs.version.outputs.tag }}
      cancel-in-progress: false
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: archive-*
          merge-multiple: true
          path: out
      - name: Publish the release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: bash .github/scripts/publish-release.sh out
