import { describe, expect, test } from "bun:test";

import { ENV, outputFlags, requireEnv, type Env } from "./env";
import { name } from "./plugin";

describe("requireEnv", () => {
  test("returns the value", () => {
    expect(requireEnv(ENV.domain, { [ENV.domain]: "127.0.0.1:1" })).toBe("127.0.0.1:1");
  });

  test.each([ENV.domain, ENV.token])("names %s when it is missing and says how to run the plugin", (variable) => {
    expect(() => requireEnv(variable, {})).toThrow(variable);
    expect(() => requireEnv(variable, {})).toThrow(`auth0 ${name}`);
  });
});

describe("outputFlags", () => {
  const cases: { env: Env; want: { json: boolean; compact: boolean } }[] = [
    { env: {}, want: { json: false, compact: false } },
    { env: { [ENV.json]: "true" }, want: { json: true, compact: false } },
    { env: { [ENV.json]: "false", [ENV.jsonCompact]: "true" }, want: { json: true, compact: true } },
  ];

  test.each(cases)("reads $env", ({ env, want }) => {
    expect(outputFlags(env)).toEqual(want);
  });
});
