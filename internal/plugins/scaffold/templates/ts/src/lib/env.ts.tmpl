import { name } from "./plugin";

/**
 * The variables the CLI sets for every run. This is the only file that reads
 * them, so look here when the plugin cannot reach the API.
 */
export const ENV = {
  /** The address of the CLI proxy as host:port. It is not the tenant domain. */
  domain: "AUTH0_PLUGIN_DOMAIN",
  /** A secret for this run only. It lets the plugin use the proxy, which swaps in the real token. */
  token: "AUTH0_PLUGIN_MANAGEMENT_TOKEN",
  /** `true` when the user asked for JSON output. Agent mode turns it on. */
  json: "AUTH0_PLUGIN_JSON",
  jsonCompact: "AUTH0_PLUGIN_JSON_COMPACT",
} as const;

// The proxy uses its own certificate. The CLI also sets NODE_EXTRA_CA_CERTS to
// it, which Node and Bun read at start, so no code is needed to trust it.

export type Env = Record<string, string | undefined>;

/** Returns a variable of the CLI, or an error that says what to do. */
export function requireEnv(variable: string, env: Env = process.env): string {
  const value = env[variable];
  if (!value) {
    throw new Error(
      `${variable} is not set. This plugin has to be started by the Auth0 CLI: run \`auth0 ${name}\` instead of running the file directly`,
    );
  }
  return value;
}

/** Returns the output flags of the CLI. */
export function outputFlags(env: Env = process.env): { json: boolean; compact: boolean } {
  const compact = env[ENV.jsonCompact] === "true";
  return { json: compact || env[ENV.json] === "true", compact };
}
