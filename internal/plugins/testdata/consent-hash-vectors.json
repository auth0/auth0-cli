{
  "description": "Test vectors for the consent hash returned by Manifest.PermissionsHash. Each vector lists the commands of a manifest (name, interactive and permissions) and the expected hash. The hash is the SHA-256 of the canonical JSON described in the PermissionsHash documentation. This file is shared with the plugin catalog so that both implementations produce the same hashes.",
  "vectors": [
    {
      "name": "example manifest from valid-manifest.json",
      "commands": [
        {
          "name": "checkmate",
          "interactive": false,
          "permissions": {
            "scopes": [
              "read:tenant_settings",
              "read:clients",
              "read:connections"
            ],
            "hosts": [
              {
                "host": "api.github.com",
                "reason": "Check SDK versions against GitHub advisories"
              }
            ],
            "files": [
              {
                "path": "$CWD",
                "access": "write",
                "reason": "Save the audit report"
              }
            ],
            "env": [
              {
                "name": "AWS_PROFILE",
                "reason": "Use the caller's AWS profile"
              }
            ]
          }
        }
      ],
      "hash": "sha256:4051f9072e71ee6925a0e05870c9345bb1f8534b216f86a3969b8750a6350b07"
    },
    {
      "name": "command without permissions",
      "commands": [
        {
          "name": "plain",
          "interactive": false
        }
      ],
      "hash": "sha256:9bc7b698c01b0679b7f3e630a03feb4e6fe19869921900f11eb5f69c4456d6cf"
    },
    {
      "name": "unicode text in reasons and paths",
      "commands": [
        {
          "name": "audit",
          "interactive": false,
          "permissions": {
            "scopes": [
              "read:clients"
            ],
            "hosts": [
              {
                "host": "api.github.com",
                "reason": "Prüfe SDK-Versionen"
              }
            ],
            "files": [
              {
                "path": "$CWD/Berichte",
