            "env": [
              {
                "name": "HOME",
                "reason": "Finde die Konfiguration im Benutzerverzeichnis"
              }
            ]
          }
        }
      ],
      "hash": "sha256:65147705407a2d292fc0c928f6983360687a9d175ac60c24f74bd1ebc5c4562e"
    },
    {
